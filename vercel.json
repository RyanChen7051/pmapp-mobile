{
  "version": 2,
  "buildCommand": "echo 'PMApp PWA is prebuilt (bundle.js already in repo) — no build step needed'",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/bundle.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
