# ───────── PMApp AI 后端环境变量 ─────────
# 复制本文件为 .env 并填入真实值

# Supabase（与 PWA 前端共用同一项目，沿用现有值即可）
SUPABASE_URL=https://nsnmtkukxquhinlmbejg.supabase.co
SUPABASE_KEY=sb_publishable_YB5z3cQK-vCg67--oKpSrg_63STgMJW

# ── 免费 LLM：DeepSeek（推荐）──
# 注册/获取 key：https://platform.deepseek.com → API Keys → 创建
# 新用户有免费额度，deepseek-chat 价格极低且支持工具调用
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=在此填入你的DeepSeek_API_Key
LLM_MODEL=deepseek-chat

# 备选（完全免费、有速率限制）：智谱 GLM-4-Flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的智谱Key
# LLM_MODEL=glm-4-flash

# 监听端口（CloudStudio 预览端口需与此一致，默认 3000）
PORT=3000
